# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase Postgres connection string (from your Supabase project settings)
# Supabase Postgres — copy these from the "Connect" button in your Supabase
# project's top bar → ORM tab → Prisma. Replace [YOUR-PASSWORD] with your
# actual database password in both lines.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.pmjgnyjjbwoiwiztgxac:Mamamiyo2026@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.pmjgnyjjbwoiwiztgxac:Mamamiyo2026@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# Supabase project (for file storage — reference photos)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend (email) — this is the only messaging channel active for launch
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@mamamiyo-photography.com"

# --- WhatsApp / Twilio — leave blank for now ---
# Launching email-only while the WhatsApp Business Platform application is
# pending Meta approval. Nothing else in the app needs to change when this
# is ready — just fill these in and implement the real call in
# src/lib/whatsapp.ts (see the comment at the top of that file).
