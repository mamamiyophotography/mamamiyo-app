# Copy this file to .env and fill in real values. Never commit .env itself.

# Supabase Postgres connection string (from your Supabase project settings)
# Supabase Postgres — copy these from the "Connect" button in your Supabase
# project's top bar → ORM tab → Prisma. Replace [YOUR-PASSWORD] with your
# actual database password in both lines.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://USER:PASSWORD@POOLER_HOST:5432/postgres"

# Supabase project (for file storage — reference photos)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Resend (email) — this is the only messaging channel active for launch
RESEND_API_KEY=""
RESEND_FROM_EMAIL="hello@mamamiyo-photography.com"

# Whapi.Cloud internal WhatsApp alerts. Keep the token server-side only.
WHAPI_TOKEN=""
PHOTOGRAPHER_PHONE="+65XXXXXXXX"
# Leave false to send WhatsApp alerts only to the photographer.
WHATSAPP_CLIENT_NOTIFICATIONS="false"

# Admin login (single shared account — this is a solo-operator app)
# Generate the hash with: npx tsx scripts/hash-password.ts "your-chosen-password"
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
# Any long random string (16+ chars) — used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Conversion tracking: leave disabled until reviewed migration + GA4 setup.
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
NEXT_PUBLIC_ANALYTICS_HOST="mamamiyo-app.vercel.app"
ANALYTICS_DB_ENABLED="false"
ANALYTICS_SEND_ENABLED="false"
GA4_API_SECRET=""
